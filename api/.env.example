VRT_APP_NAME=Range & React
VRT_APP_ENV=development
VRT_APP_VERSION=0.7.0
VRT_FRONTEND_URL=http://127.0.0.1:3000
VRT_SUPPORT_EMAIL=support@example.com
VRT_LEGAL_COMPANY_NAME=Range & React
VRT_LEGAL_EFFECTIVE_DATE=2026-04-06
VRT_LEGAL_JURISDICTION=Missouri, USA
VRT_PUBLIC_STATUS_DETAILED_CHECKS=true
VRT_PUBLIC_STATUS_SHOW_DEMO_DETAILS=true
VRT_EMAIL_PROVIDER=
VRT_RESEND_API_KEY=
VRT_EMAIL_FROM=
VRT_EMAIL_REPLY_TO=support@example.com
VRT_WELCOME_EMAIL_ENABLED=true
VRT_SIGNUP_INVITE_ACCEPT_PATH=/login
VRT_PASSWORD_RESET_PATH=/reset-password
VRT_DOCS_ENABLED=true
VRT_DEBUG_ROUTES_ENABLED=true
VRT_LOG_LEVEL=INFO
VRT_LOG_JSON=false
VRT_REQUEST_LOG_ENABLED=true
VRT_SENTRY_DSN=
VRT_SENTRY_ENVIRONMENT=development
VRT_SENTRY_TRACES_SAMPLE_RATE=0
VRT_SENTRY_PROFILES_SAMPLE_RATE=0
VRT_STRICT_STARTUP_CHECKS=false
VRT_PASSWORD_RESET_RETURNS_TOKEN=true
VRT_REQUIRE_SIGNUP_INVITE=false
# Prefer VRT_DATABASE_URL in new environments. Leave blank to use the SQLite fallback below.
VRT_DATABASE_URL=
VRT_DATABASE_PATH=./data/villain_range_trainer.db
VRT_DB_POOL_MIN_SIZE=1
VRT_DB_POOL_MAX_SIZE=8
VRT_AUTH_TOKEN_TTL_DAYS=30
VRT_PASSWORD_RESET_TTL_HOURS=2
VRT_ADMIN_ANALYTICS_CACHE_TTL_SECONDS=300
VRT_DASHBOARD_OVERVIEW_CACHE_TTL_SECONDS=120
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VRT_TRUSTED_HOSTS=localhost,127.0.0.1

# Demo / staging helpers
VRT_DEMO_MODE_ENABLED=false
VRT_DEMO_PUBLIC_CREDENTIALS=false
VRT_DEMO_ORG_NAME=Range & React Demo
VRT_DEMO_OWNER_EMAIL=owner@demo.local
VRT_DEMO_COACH_EMAIL=coach@demo.local
VRT_DEMO_MEMBER_EMAIL=member@demo.local
VRT_DEMO_SEED_PASSWORD=DemoPass123!
